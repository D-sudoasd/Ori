{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:spectra-to-origin:import-plan:v1",
  "title": "SpectraToOrigin generic import plan",
  "description": "Declarative, versioned plan for validating tabular inputs and creating an Origin project or workbook.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "output", "tables"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format", "overwrite", "keep_open"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "format": {"enum": ["opju", "xlsx"]},
        "overwrite": {"type": "boolean", "default": false},
        "keep_open": {"type": "boolean", "default": false}
      }
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/table"}
    }
  },
  "$defs": {
    "selector": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"type": "string", "minLength": 1}
      ]
    },
    "readerOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sheet", "header", "skip_rows", "delimiter", "encoding", "missing_values", "formula_policy"],
      "properties": {
        "sheet": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        },
        "header": {"type": "boolean"},
        "skip_rows": {"type": "integer", "minimum": 0},
        "delimiter": {"enum": ["auto", "whitespace", ",", ";", "\t"]},
        "encoding": {"type": "string", "minLength": 1},
        "missing_values": {"type": "array", "items": {"type": "string"}},
        "formula_policy": {"enum": ["cached", "text"]}
      }
    },
    "plot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "x", "y", "y_error", "title", "x_label", "y_label"],
      "properties": {
        "kind": {"enum": ["none", "line", "scatter", "line_symbol", "column"]},
        "x": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/selector"}]},
        "y": {"type": "array", "items": {"$ref": "#/$defs/selector"}, "uniqueItems": true},
        "y_error": {
          "type": "object",
          "description": "Keys are original unique source column names for selected Y columns; values are error-column names or zero-based indexes.",
          "additionalProperties": {"$ref": "#/$defs/selector"}
        },
        "title": {"type": "string"},
        "x_label": {"type": "string"},
        "y_label": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "none"}}},
          "then": {
            "properties": {"x": {"type": "null"}, "y": {"maxItems": 0}, "y_error": {"maxProperties": 0}}
          },
          "else": {"properties": {"y": {"minItems": 1}}}
        }
      ]
    },
    "columnLabel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "unit": {"type": "string"}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "name", "plot", "column_labels"],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "options"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
            "options": {"$ref": "#/$defs/readerOptions"}
          }
        },
        "name": {"type": "string", "minLength": 1},
        "plot": {"$ref": "#/$defs/plot"},
        "column_labels": {
          "type": "object",
          "description": "Keys are original unique source column names; labels do not change the source data type.",
          "additionalProperties": {"$ref": "#/$defs/columnLabel"}
        }
      }
    }
  }
}
